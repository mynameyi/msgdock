{
  "name": "msgdock",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm --filter @msgdock/contracts build && pnpm --filter @msgdock/channels build && pnpm --filter @msgdock/database build && pnpm --filter @msgdock/server build && pnpm --filter @msgdock/api build && pnpm --filter @msgdock/worker build && node scripts/generate-openapi.cjs && pnpm --filter @msgdock/api-client generate && pnpm --filter @msgdock/console build",
    "typecheck": "pnpm -r run typecheck",
    "test": "jest --runInBand",
    "lint": "eslint apps packages --max-warnings=0",
    "format": "prettier --write apps packages deploy",
    "db:generate": "pnpm --filter @msgdock/database generate",
    "db:migrate": "node --env-file=.env packages/database/node_modules/prisma/build/index.js migrate deploy --schema packages/database/prisma/schema.prisma",
    "dev:api": "node --watch --env-file=.env apps/api/dist/main.js",
    "dev:worker": "node --watch --env-file=.env apps/worker/dist/main.js",
    "dev:console": "pnpm --filter @msgdock/console dev"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "@types/jest": "^29.5.0",
    "eslint": "^10.0.0",
    "typescript-eslint": "^8.46.0",
    "@eslint/js": "^10.0.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.0"
  }
}
