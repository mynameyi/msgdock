generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid()) @db.Uuid
  username String @unique
  passwordHash String
  createdAt DateTime @default(now())
  sessions Session[]
}
model Session {
  id String @id
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  csrfToken String
  expiresAt DateTime
  @@index([expiresAt])
}
model ApiKey {
  id String @id @default(uuid()) @db.Uuid
  name String
  enabled Boolean @default(true)
  hash String @unique
  secret String?
  prefix String
  revokedAt DateTime?
  createdAt DateTime @default(now())
  notifications Notification[]
}
model ApiSettings {
  id String @id @default("default")
  authEnabled Boolean @default(true)
  perMinuteLimit Int @default(60)
}
model Channel {
  id String @id @default(uuid()) @db.Uuid
  shortId String @unique @default(dbgenerated("('ch_'::text || substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 12))"))
  name String
  type String
  pluginVersion String @default("1.0.0")
  configVersion Int @default(1)
  credentials String
  enabled Boolean @default(true)
  lastStatus String @default("untested")
  lastCheckedAt DateTime?
  createdAt DateTime @default(now())
  targets Target[]
}
model Target {
  id String @id @default(uuid()) @db.Uuid
  name String
  channelId String @db.Uuid
  channel Channel @relation(fields:[channelId],references:[id])
  config Json
  createdAt DateTime @default(now())
}
model Topic {
  id String @id @default(uuid()) @db.Uuid
  key String @unique
  name String
  targetIds String[]
  createdAt DateTime @default(now())
}
model Template {
  id String @id @default(uuid()) @db.Uuid
  key String @unique
  name String
  createdAt DateTime @default(now())
  versions TemplateVersion[]
}
model TemplateVersion {
  id String @id @default(uuid()) @db.Uuid
  templateId String @db.Uuid
  template Template @relation(fields:[templateId],references:[id])
  version Int
  body String
  createdAt DateTime @default(now())
  @@unique([templateId,version])
}
model Notification {
  id String @id @default(uuid()) @db.Uuid
  apiKeyId String? @db.Uuid
  apiKey ApiKey? @relation(fields:[apiKeyId],references:[id],onDelete:Restrict)
  idempotencyScope String
  idempotencyKey String
  requestHash String
  snapshot Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  deliveries Delivery[]
  @@unique([idempotencyScope,idempotencyKey])
  @@index([createdAt])
}
model Delivery {
  id String @id @default(uuid()) @db.Uuid
  notificationId String @db.Uuid
  notification Notification @relation(fields:[notificationId],references:[id])
  channelId String @db.Uuid
  targetId String @db.Uuid
  targetName String
  targetSnapshot Json
  pluginId String
  pluginVersion String @default("1.0.0")
  configVersion Int @default(1)
  text String
  status String @default("pending")
  generation Int @default(0)
  attemptCount Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseToken String?
  leaseExpiresAt DateTime?
  requestStartedAt DateTime?
  expiresAt DateTime
  lastCode String?
  lastMessage String?
  platformMessageId String?
  replayOfDeliveryId String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attempts Attempt[]
  @@index([status,nextAttemptAt])
  @@index([status,leaseExpiresAt])
  @@index([createdAt])
}
model Attempt {
  id String @id @default(uuid()) @db.Uuid
  deliveryId String @db.Uuid
  delivery Delivery @relation(fields:[deliveryId],references:[id])
  token String @unique
  number Int
  status String @default("preparing")
  code String?
  message String?
  startedAt DateTime @default(now())
  requestStartedAt DateTime?
  finishedAt DateTime?
}
model Outbox {
  id String @id @default(uuid()) @db.Uuid
  deliveryId String @db.Uuid
  generation Int
  publishedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([deliveryId,generation])
  @@index([publishedAt])
}
model Audit {
  id String @id @default(uuid()) @db.Uuid
  actor String
  action String
  resource String
  details Json
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model RuntimeState {
  key String @id
  value String
  updatedAt DateTime @updatedAt
}
