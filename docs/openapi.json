        ]
      },
      "NotificationDto": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string"
          },
          "target": {
            "$ref": "#/components/schemas/TargetDto"
          },
          "message": {
            "$ref": "#/components/schemas/TextDto"
          },
          "template": {
