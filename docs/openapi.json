  "info": {
    "title": "MsgDock API",
    "description": "",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "不透明 API Key，通过 Authorization: Bearer 传递"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "md_session"
      },
      "anonymous": {
        "type": "http",
        "scheme": "bearer",
        "description": "仅为发送接口的匿名配置说明；实际以应用 authMode 为准"
      }
    },
    "schemas": {
      "SetupDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          },
          "setupToken": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password",
          "setupToken"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "PasswordDto": {
        "type": "object",
        "properties": {
          "oldPassword": {
            "type": "string",
            "format": "password"
          },
          "newPassword": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "oldPassword",
          "newPassword"
        ]
      },
      "ApplicationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "authMode": {
            "type": "string",
            "enum": [
              "api_key",
              "none"
            ],
            "default": "api_key"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "allowedTargetIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "perMinuteLimit": {
            "type": "number",
            "default": 60
          }
        },
        "required": [
          "name",
          "key",
          "authMode",
          "enabled",
          "allowedTargetIds",
          "perMinuteLimit"
        ]
      },
      "ChannelDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "已注册渠道插件的稳定 ID，通过 channel-plugins 查询"
          },
          "pluginVersion": {
            "type": "string",
            "description": "新渠道默认使用当前插件版本；已有渠道不可直接切换"
          },
          "credentials": {
            "type": "object",
            "additionalProperties": true,
            "description": "按插件 configSchema 校验；整体加密保存，永不回传"
          },
          "targetConfig": {
            "type": "object",
            "additionalProperties": true,
            "description": "按插件 targetSchema 校验"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "targetName": {
            "type": "string"
          },
          "openConversationId": {
            "type": "string",
            "deprecated": true,
            "description": "0.1.0 兼容字段；新客户端使用 targetConfig"
          }
        },
        "required": [
          "name",
          "type",
          "credentials",
          "enabled",
          "targetName"
        ]
      },
      "TopicDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "targetIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "key",
          "targetIds"
        ]
      },
      "TemplateDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "key",
          "body"
        ]
      },
      "ReplayDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          },
