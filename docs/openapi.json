    "/api/v1/apps/{appKey}/notifications": {
      "post": {
        "operationId": "NotificationsController_create",
        "parameters": [
          {
            "name": "appKey",
            "required": true,
            "in": "path",
            "description": "控制台中配置的接入应用 Key",
            "schema": {
              "example": "order-service",
              "type": "string"
            }
          },
          {
            "name": "idempotency-key",
            "required": true,
            "in": "header",
            "description": "应用内唯一，1–200 个可见 ASCII 字符",
            "schema": {
              "type": "string",
              "example": "replace-with-your-unique-event-id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationDto"
              },
              "examples": {
                "text": {
                  "summary": "文本消息（替换目标 UUID）",
                  "value": {
                    "event": "order.paid",
                    "target": {
                      "type": "targets",
                      "ids": [
                        "00000000-0000-4000-8000-000000000001"
                      ]
                    },
                    "message": {
                      "text": "订单支付成功。"
                    },
                    "expires_in": 3600
                  }
                },
                "template": {
                  "summary": "主题与模板（先在控制台创建）",
                  "value": {
                    "event": "order.paid",
                    "target": {
                      "type": "topic",
                      "key": "finance"
                    },
                    "template": {
                      "key": "order_paid"
                    },
                    "variables": {
                      "order_no": "20261021001",
                      "amount": "299.00"
                    },
                    "expires_in": 3600
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "已持久化受理，平台投递在后台进行",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedNotificationDto"
                }
              }
            }
          },
          "400": {
            "description": "参数、目标、消息或幂等键无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "需要有效的应用 API Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "API Key 不属于该应用或无权访问目标",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "409": {
            "description": "相同幂等键对应不同请求",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "应用发送频率超限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "503": {
            "description": "服务暂时不可用或投递积压达到受理上限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          },
          {}
        ],
        "summary": "受理通知（默认需要 Bearer API Key；仅显式关闭鉴权的应用允许匿名发送）",
        "tags": [
          "通知 API"
        ]
      }
    },
