          "confirmed"
        ]
      },
      "TestSendDto": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string"
          },
          "targetIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "applicationId",
          "targetIds",
          "text"
        ]
      },
      "TargetDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "targets",
              "topic"
            ]
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "key": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ]
      },
      "TextDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
