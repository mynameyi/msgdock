    "/api/v1/apps/{appKey}/notifications/{id}/deliveries": {
      "get": {
        "description": "每页最多 50 条。使用返回的 nextCursor 继续查询；null 表示末页。",
        "operationId": "NotificationsController_deliveries",
        "parameters": [
          {
            "name": "appKey",
            "required": true,
            "in": "path",
            "description": "控制台中配置的接入应用 Key",
            "schema": {
              "example": "order-service",
              "type": "string"
            }
          },
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "authorization",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "上一页返回的 nextCursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryPageDto"
                }
              }
            }
          },
          "400": {
            "description": "参数、目标、消息或幂等键无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "需要有效的应用 API Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "API Key 不属于该应用或无权访问目标",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "通知不存在或不属于该应用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "503": {
            "description": "服务暂时不可用或投递积压达到受理上限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "分页查询通知的投递结果",
        "tags": [
          "通知 API"
        ]
      }
    },
    "/api/v1/apps/{appKey}/deliveries/{id}": {
      "get": {
        "operationId": "NotificationsController_delivery",
        "parameters": [
          {
            "name": "appKey",
            "required": true,
            "in": "path",
            "description": "控制台中配置的接入应用 Key",
            "schema": {
              "example": "order-service",
              "type": "string"
            }
          },
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "authorization",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryResultDto"
                }
              }
            }
          },
          "400": {
            "description": "参数、目标、消息或幂等键无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "需要有效的应用 API Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "API Key 不属于该应用或无权访问目标",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "投递不存在或不属于该应用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "503": {
            "description": "服务暂时不可用或投递积压达到受理上限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "查询单个目标的投递结果",
        "tags": [
          "通知 API"
        ]
      }
    }
  },
  "info": {
    "title": "MsgDock API",
    "description": "",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "不透明 API Key，通过 Authorization: Bearer 传递"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "md_session"
      },
      "anonymous": {
        "type": "http",
        "scheme": "bearer",
        "description": "仅为发送接口的匿名配置说明；实际以应用 authMode 为准"
      }
    },
    "schemas": {
      "SetupDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          },
          "setupToken": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password",
          "setupToken"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "PasswordDto": {
        "type": "object",
        "properties": {
          "oldPassword": {
            "type": "string",
            "format": "password"
          },
          "newPassword": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "oldPassword",
          "newPassword"
        ]
      },
      "ApplicationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "authMode": {
            "type": "string",
            "enum": [
              "api_key",
              "none"
            ],
            "default": "api_key"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "allowedTargetIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "perMinuteLimit": {
            "type": "number",
            "default": 60
          }
        },
        "required": [
          "name",
          "key",
          "authMode",
          "enabled",
          "allowedTargetIds",
          "perMinuteLimit"
        ]
      },
      "ChannelDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "已注册渠道插件的稳定 ID，通过 channel-plugins 查询"
          },
          "pluginVersion": {
            "type": "string",
            "description": "新渠道默认使用当前插件版本；已有渠道不可直接切换"
          },
          "credentials": {
            "type": "object",
            "additionalProperties": true,
            "description": "按插件 configSchema 校验；整体加密保存，永不回传"
          },
          "targetConfig": {
            "type": "object",
            "additionalProperties": true,
            "description": "按插件 targetSchema 校验"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "targetName": {
            "type": "string"
          },
          "openConversationId": {
            "type": "string",
            "deprecated": true,
            "description": "0.1.0 兼容字段；新客户端使用 targetConfig"
          }
        },
        "required": [
          "name",
          "type",
          "credentials",
          "enabled",
          "targetName"
        ]
      },
      "TopicDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "targetIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "key",
          "targetIds"
        ]
      },
      "TemplateDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "key",
          "body"
        ]
      },
      "ReplayDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "reason",
          "confirmed"
        ]
      },
      "TestSendDto": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string"
          },
          "targetIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "applicationId",
          "targetIds",
          "text"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "HTTP_401"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ]
      },
      "TargetDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "targets",
              "topic"
            ],
            "example": "targets",
            "description": "targets 使用 ids；topic 使用 key。所有目标需在应用授权范围内。"
          },
          "ids": {
            "example": [
              "00000000-0000-4000-8000-000000000001"
            ],
            "description": "type=targets 时填写实际目标 UUID，最多 500 个",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "key": {
            "type": "string",
            "example": "finance",
            "description": "type=topic 时填写主题 Key"
          }
        },
        "required": [
          "type"
        ]
      },
      "TextDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "example": "订单支付成功。",
            "description": "非空文本，最终 UTF-8 内容最多 2000 字节，且不能超过渠道插件上限"
          }
        },
        "required": [
          "text"
        ]
      },
      "TemplateRefDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          }
        },
        "required": [
          "key"
        ]
      },
      "NotificationDto": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "example": "order.paid",
            "minLength": 1,
            "maxLength": 100
          },
          "target": {
            "$ref": "#/components/schemas/TargetDto"
          },
          "message": {
            "description": "直接文本消息；message 与 template 必须且只能提供一个",
            "allOf": [
              {
                "$ref": "#/components/schemas/TextDto"
              }
            ]
          },
          "template": {
            "description": "引用控制台创建的模板；提供 template 时省略 message",
            "allOf": [
              {
                "$ref": "#/components/schemas/TemplateRefDto"
              }
            ]
          },
          "variables": {
            "type": "object",
            "additionalProperties": true
          },
          "expires_in": {
            "type": "number",
            "default": 3600,
            "minimum": 1,
            "maximum": 604800,
            "description": "有效期，单位秒"
          }
        },
        "required": [
          "event",
          "target"
        ]
      },
      "AcceptedNotificationDto": {
        "type": "object",
        "properties": {
          "notification_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted_for_processing"
            ]
          },
          "delivery_count": {
            "type": "number"
          },
          "idempotency_hit": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "notification_id",
          "status",
          "delivery_count",
          "idempotency_hit",
          "request_id"
        ]
      },
      "DeliverySummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "sending",
              "retry_wait",
              "accepted",
              "failed",
              "unknown",
              "expired",
              "cancelled"
            ],
            "description": "accepted 表示平台接受；unknown 表示结果不明，重发前请人工核实"
          },
          "targetName": {
            "type": "string"
          },
          "attemptCount": {
            "type": "number"
          },
          "lastCode": {
            "type": "string",
            "nullable": true
          },
          "lastMessage": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "status",
          "targetName",
          "attemptCount"
        ]
      },
      "NotificationResultDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "event": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "deliveries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeliverySummaryDto"
            }
          }
        },
        "required": [
          "id",
          "event",
          "createdAt",
          "expiresAt",
          "deliveries"
        ]
      },
      "DeliveryListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "sending",
              "retry_wait",
              "accepted",
              "failed",
              "unknown",
              "expired",
              "cancelled"
            ],
            "description": "accepted 表示平台接受；unknown 表示结果不明，重发前请人工核实"
          },
          "targetName": {
            "type": "string"
          },
          "attemptCount": {
            "type": "number"
          },
          "lastCode": {
            "type": "string",
            "nullable": true
          },
          "lastMessage": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "status",
          "targetName",
          "attemptCount",
          "createdAt"
        ]
      },
      "DeliveryPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeliveryListItemDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "下一页 cursor；null 表示没有后续页"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "DeliveryResultDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "sending",
              "retry_wait",
              "accepted",
              "failed",
              "unknown",
              "expired",
              "cancelled"
            ],
            "description": "accepted 表示平台接受；unknown 表示结果不明，重发前请人工核实"
          },
          "targetName": {
            "type": "string"
          },
          "attemptCount": {
            "type": "number"
          },
          "lastCode": {
            "type": "string",
            "nullable": true
          },
          "lastMessage": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "notificationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "status",
          "targetName",
          "attemptCount",
          "createdAt",
          "notificationId"
        ]
      }
    }
  }
}
