# 本地开发示例。Docker 单容器运行时自动生成内部连接配置与密钥。
DATABASE_URL=postgresql://msgdock:YOUR_LOCAL_PASSWORD@127.0.0.1:55432/msgdock
REDIS_URL=redis://127.0.0.1:56379
# 开发时使用 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" 生成。
MSGDOCK_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
MSGDOCK_SETUP_TOKEN=REPLACE_WITH_RANDOM_INITIALIZATION_TOKEN
PORT=3302
TZ=Asia/Shanghai
COOKIE_SECURE=false
